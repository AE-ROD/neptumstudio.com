# Dominio canónico (canonical, hreflang, og:url, sitemap). Sin barra final.
# Si no se define, astro.config usa https://neptumstudio.vercel.app
SITE_URL=https://neptumstudio.vercel.app

# Enlace de agenda para "Reserva tu Diagnóstico Digital" (Calendly o Cal.com).
# Si está vacío o no existe, el bloque de reserva no se muestra.
PUBLIC_BOOKING_URL=

# Clave pública de Web3Forms (opcional; por defecto se usa la clave actual del estudio).
PUBLIC_WEB3FORMS_KEY=
