    {
      "source": "/pt/restaurante",
      "destination": "/pt/servicos/",
      "statusCode": 301
    },
    {
      "source": "/pt/restaurante/",
      "destination": "/pt/servicos/",
      "statusCode": 301
    },
    {
      "source": "/pt/oficio",
      "destination": "/pt/servicos/",
      "statusCode": 301
    },
    {
      "source": "/pt/oficio/",
      "destination": "/pt/servicos/",
