      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/resto",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/resto/",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/oficio",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/oficio/",
      "destination": "/servicios/",
      "statusCode": 301
    },
    {
      "source": "/en/health",
      "destination": "/en/services/",
      "statusCode": 301
    },
    {
      "source": "/en/health/",
      "destination": "/en/services/",
      "statusCode": 301
