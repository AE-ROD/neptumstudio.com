---
// src/pages/404.astro — página estática de error (Vercel la sirve para cualquier ruta inexistente).
import Layout from '../layouts/Layout.astro';
import LogoMark from '../components/LogoMark.astro';
import { getT, routes, locales } from '../i18n';

const t = getT('es');
---
<Layout title={t.not_found.title} description={t.not_found.text} locale="es" noindex>
  <main id="main" class="not-found">
    <LogoMark class="not-found-mark" />
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 class="not-found-title">{t.not_found.h1}</h1>
    <p class="not-found-sub">{t.not_found.text}</p>
    <div class="not-found-links">
      <a href={routes.es.home} class="btn btn-light">{t.not_found.home}</a>
      <a href={routes.es.services} class="btn btn-outline-light">{t.not_found.services}</a>
    </div>
    <nav class="not-found-lang" aria-label={t.nav.lang_label}>
      {locales.map((l) => (
        <a href={routes[l].home} lang={l} hreflang={l}>{getT(l).not_found.home} ({l.toUpperCase()})</a>
      ))}
    </nav>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100vh;
    min-height: 100svh;
    background: var(--color-navy-deep);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    gap: 1.25rem;
  }
  .not-found-mark { width: 48px; height: 48px; color: var(--color-navy-mid); }
  .not-found-code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 20vw, 12rem);
    line-height: 1;
    color: var(--color-navy-mid);
    letter-spacing: -0.02em;
  }
  .not-found-title { font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 2.5rem); font-weight: 400; color: var(--color-white); }
  .not-found-sub { font-size: 0.9375rem; color: var(--color-silver); max-width: 40ch; line-height: 1.6; font-weight: 300; }
  .not-found-links { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem; }
  .not-found-lang { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: center; margin-top: 1.5rem; }
  .not-found-lang a { font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-silver); border-bottom: 1px solid var(--color-slate); padding-bottom: 2px; }
  .not-found-lang a:hover { color: var(--color-white); border-color: var(--color-white); }
</style>
