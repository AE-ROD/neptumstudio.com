---
// src/views/ContactView.astro — página /contacto, compartida por los tres idiomas.
import type { Locale } from '../i18n';
import { getT } from '../i18n';
import Layout from '../layouts/Layout.astro';
import Loader from '../components/Loader.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Price from '../components/catalog/Price.astro';
import { CONTACT, BOOKING_URL } from '../data/contact';
import { diagnostic } from '../data/catalog';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getT(locale);
const c = t.contact_page.channels;

const channels = [
  { label: c.email, value: CONTACT.email, hint: c.email_hint, href: `mailto:${CONTACT.email}`, external: false },
  { label: c.whatsapp, value: CONTACT.phoneDisplay, hint: c.whatsapp_hint, href: CONTACT.whatsappUrl, external: true },
  { label: c.instagram, value: CONTACT.instagramHandle, hint: c.instagram_hint, href: CONTACT.instagramUrl, external: true },
  { label: c.location, value: c.location_value, hint: c.location_hint, href: null, external: false },
];
---
<Layout title={t.meta.contact_title} description={t.meta.contact_description} locale={locale} page="contact">
  <Loader />
  <Navbar locale={locale} page="contact" />
  <main id="main">
    <PageHero eyebrow={t.contact_page.eyebrow} title={t.contact_page.h1} lead={t.contact_page.intro} />

    <section class="section section--cream">
      <div class="container contact-layout">

        <aside class="contact-side">
          <ul class="channels" role="list">
            {channels.map((ch) => (
              <li class="channel">
                <span class="channel-label">{ch.label}</span>
                {ch.href
                  ? <a href={ch.href} class="channel-value" target={ch.external ? '_blank' : undefined} rel={ch.external ? 'noopener' : undefined}>{ch.value}</a>
                  : <span class="channel-value">{ch.value}</span>}
                <span class="channel-hint">{ch.hint}</span>
              </li>
            ))}
          </ul>

          {BOOKING_URL && (
            <section class="booking" aria-labelledby="booking-title">
              <p class="eyebrow eyebrow--light">{t.contact_page.booking.eyebrow}</p>
              <h2 id="booking-title" class="display-md">{t.contact_page.booking.h2}</h2>
              <p class="booking-text">{t.contact_page.booking.text} {diagnostic.note[locale]}</p>
              <div class="booking-price">
                <span class="sku">{diagnostic.sku}</span>
                <Price price={diagnostic.price} locale={locale} size="sm" />
              </div>
              <a href={BOOKING_URL} class="btn btn-light" target="_blank" rel="noopener">{t.contact_page.booking.cta}</a>
            </section>
          )}
        </aside>

        <div class="contact-main">
          <ContactForm locale={locale} />
        </div>

      </div>
    </section>
  </main>
  <Footer locale={locale} page="contact" />
</Layout>

<style>
  .contact-layout { display: grid; grid-template-columns: 5fr 7fr; gap: 4rem; align-items: start; }
  .contact-side { display: flex; flex-direction: column; gap: 2.5rem; }

  .channels { display: flex; flex-direction: column; border-top: 1px solid var(--color-navy-deep); }
  .channel { display: flex; flex-direction: column; gap: 0.2rem; padding: 1.1rem 0; border-bottom: 1px solid var(--color-cream-border); }
  .channel-label { font-size: 0.625rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-slate); font-weight: 500; }
  .channel-value { font-family: var(--font-display); font-size: 1.375rem; color: var(--color-navy-deep); transition: color 0.2s; }
  a.channel-value:hover { color: var(--color-slate); }
  .channel-hint { font-size: 0.8125rem; color: var(--color-slate); font-weight: 300; }

  .booking {
    background: var(--color-navy-deep);
    color: var(--color-white);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .booking-text { font-size: 0.9rem; color: var(--color-silver); line-height: 1.65; font-weight: 300; }
  .booking-price { display: flex; align-items: baseline; gap: 0.75rem; color: var(--color-white); }
  .booking-price .sku { color: var(--color-silver); }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; gap: 3rem; }
    .contact-main { order: -1; }
  }
</style>
