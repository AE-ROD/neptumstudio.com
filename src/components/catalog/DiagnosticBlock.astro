---
// src/components/catalog/DiagnosticBlock.astro — "Punto de partida": Diagnóstico Digital (bloque oscuro).
import type { Locale } from '../../i18n';
import { getT, quoteHref } from '../../i18n';
import { diagnostic } from '../../data/catalog';
import Price from './Price.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getT(locale);
---

<section id="diagnostico" class="diag section--navy-mid" aria-labelledby="diag-title">
  <div class="container diag-grid">
    <div class="diag-text">
      <p class="eyebrow eyebrow--light">{t.services_page.start.eyebrow}</p>
      <h2 id="diag-title" class="display-lg">{t.services_page.start.h2}</h2>
      <p class="section-lead">{t.services_page.start.text}</p>
      <p class="diag-audience">{diagnostic.audience?.[locale]}</p>
    </div>

    <div class="diag-card">
      <div class="diag-card-head">
        <span class="sku diag-sku">{diagnostic.sku}</span>
        <h3 class="diag-name">{diagnostic.name[locale]}</h3>
      </div>
      <Price price={diagnostic.price} locale={locale} size="lg" />
      <p class="diag-note">{diagnostic.note[locale]}</p>
      <p class="diag-includes-title">{t.services_page.start.includes}</p>
      <ul class="diag-includes" role="list">
        {diagnostic.includes.map((item) => (
          <li><span aria-hidden="true">✓</span><span>{item[locale]}</span></li>
        ))}
      </ul>
      <a href={quoteHref(locale, diagnostic.id)} class="btn btn-light diag-cta">{t.services_page.start.cta}</a>
    </div>
  </div>
</section>

<style>
  .diag { padding: var(--section-pad) 0; }
  .diag-grid { display: grid; grid-template-columns: 6fr 5fr; gap: 4rem; align-items: center; }
  .diag-text { display: flex; flex-direction: column; gap: 1rem; }
  .diag-audience { font-family: var(--font-display); font-style: italic; font-size: 1.25rem; color: var(--color-silver); }

  .diag-card {
    background: var(--color-navy-deep);
    border: 1px solid rgba(255,255,255,0.12);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .diag-card-head { display: flex; flex-direction: column; gap: 0.4rem; }
  .diag-sku { color: var(--color-silver); }
  .diag-name { font-family: var(--font-display); font-size: 1.75rem; font-weight: 400; }
  .diag-note { font-size: 0.8125rem; color: var(--color-silver); font-weight: 300; }
  .diag-includes-title { font-size: 0.625rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-silver); margin-top: 0.5rem; }
  .diag-includes { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.875rem; font-weight: 300; }
  .diag-includes li { display: flex; gap: 0.6rem; }
  .diag-includes li span:first-child { color: var(--color-silver); }
  .diag-cta { margin-top: 0.5rem; align-self: flex-start; }

  @media (max-width: 900px) {
    .diag-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .diag-cta { align-self: stretch; }
  }
</style>
