---
// src/components/ServicesSummary.astro — las cuatro líneas de servicio, con precio mínimo desde el catálogo.
import type { Locale } from '../i18n';
import { getT, routes, href } from '../i18n';
import { lines, lineInfo, minPrice, formatCLP, offersIn } from '../data/catalog';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getT(locale);

const items = lines.map((line) => ({
  id: line,
  label: lineInfo[line].label[locale],
  name: lineInfo[line].name[locale],
  summary: lineInfo[line].summary[locale],
  from: formatCLP(minPrice(line)),
  tiers: offersIn(line).map((o) => o.name[locale]),
  url: href(locale, 'services', { hash: line }),
}));
---

<section id="services" class="section section--cream">
  <div class="container">

    <div class="lines-header section-head">
      <div>
        <p class="eyebrow">{t.lines.eyebrow}</p>
        <h2 class="display-lg">{t.lines.h2}</h2>
      </div>
      <div class="lines-header-right">
        <p class="section-lead">{t.lines.description}</p>
        <a href={routes[locale].services} class="link-label link-label--dark">{t.lines.cta} →</a>
      </div>
    </div>

    <ol class="lines-grid" role="list">
      {items.map((item, i) => (
        <li class="line-card">
          <a href={item.url} class="line-link">
            <span class="sku line-num">0{i + 1}</span>
            <h3 class="line-name">{item.name}</h3>
            <p class="line-summary">{item.summary}</p>
            <p class="line-tiers">{item.tiers.join(' · ')}</p>
            <p class="line-price">
              <span class="price-from">{t.lines.from}</span>
              <span class="price-amount">{item.from}</span>
            </p>
            <span class="link-label link-label--dark line-cta">{t.lines.view} →</span>
          </a>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .lines-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .lines-header .display-lg { margin-top: 0.75rem; }
  .lines-header-right { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; padding-top: 0.5rem; }

  .lines-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .line-card { border-top: 1px solid var(--color-navy-deep); }
  .line-link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 0 1rem;
    height: 100%;
    color: var(--color-navy-deep);
  }
  .line-num { color: var(--color-slate); }
  .line-name { font-family: var(--font-display); font-size: 1.75rem; font-weight: 400; line-height: 1.1; }
  .line-summary { font-size: 0.875rem; color: var(--color-slate); line-height: 1.65; font-weight: 300; flex: 1; }
  .line-tiers { font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-slate); }
  .line-price { display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.25rem; }
  .line-price .price-from { color: var(--color-slate); }
  .line-price .price-amount { font-size: 1.5rem; }
  .line-cta { align-self: flex-start; color: var(--color-slate); margin-top: 0.25rem; }
  .line-link:hover .line-cta { color: var(--color-navy-deep); }

  @media (max-width: 900px) {
    .lines-header { grid-template-columns: 1fr; gap: 1.5rem; }
    .lines-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .lines-grid { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
