---
// src/components/Scrollytelling.astro — "Cómo trabajamos": 4 pasos con tarjeta fija y visuales con datos reales del catálogo.
import type { Locale } from '../i18n';
import { getT } from '../i18n';
import { offersIn, featureLabels, priceParts } from '../data/catalog';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getT(locale);

// Paso 03: características presentes en las tres landings (sin detalle variable) → verificable en el catálogo.
const landings = offersIn('landing');
const commonLanding = Object.keys(featureLabels.landing).filter((key) =>
  landings.every((o) => (o.features ?? []).some((f) => f.key === key && !f.detail)),
);
const commonLabels = commonLanding.map((key) => featureLabels.landing[key]?.[locale] ?? key);

// Paso 04: planes mensuales reales.
const plans = offersIn('planes').map((p) => ({ name: p.name[locale], price: priceParts(p.price).amount }));

const brief = t.how.brief.join('\n');
---

<div id="how-wrapper" class="how-wrapper">
  <section id="how" class="how-section" aria-labelledby="how-title">

    <div class="how-eyebrow-wrap">
      <p class="eyebrow how-eyebrow">{t.how.eyebrow}</p>
      <h2 id="how-title" class="display-md how-title">{t.how.h2}</h2>
    </div>

    <div class="scrolly-card" id="scrolly-card">

      <ol class="scrolly-panels" role="list">
        {t.how.steps.map((step, i) => (
          <li class:list={['scrolly-panel', { active: i === 0 }]} data-panel={i}>

            <div class="panel-left" aria-hidden="true">
              {i === 0 && (
                <div class="terminal-card">
                  <div class="terminal-bar"><span class="t-dot"></span><span class="t-dot"></span><span class="t-dot"></span></div>
                  <pre class="terminal-code" data-brief={brief}><span id="typewriter-output"></span><span class="t-cursor"></span></pre>
                </div>
              )}
              {i === 1 && (
                <div class="design-visual">
                  <div class="design-frame">
                    <div class="design-bar"></div>
                    <div class="design-content">
                      <div class="design-block tall"></div>
                      <div class="design-row"><div class="design-block"></div><div class="design-block"></div></div>
                      <div class="design-block short"></div>
                    </div>
                  </div>
                </div>
              )}
              {i === 2 && (
                <div class="facts-visual">
                  <p class="facts-title">{t.how.step3_title}</p>
                  <ul class="facts-list" role="list">
                    {commonLabels.map((label) => (
                      <li><span class="facts-check">✓</span><span>{label}</span></li>
                    ))}
                  </ul>
                </div>
              )}
              {i === 3 && (
                <div class="facts-visual">
                  <p class="facts-title">{t.how.step4_title}</p>
                  <ul class="facts-list facts-list--plans" role="list">
                    {plans.map((p) => (
                      <li><span>{p.name}</span><span class="facts-price">{p.price}<small>{t.common.per_month}</small></span></li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <div class="panel-right">
              <span class="step-num sku">{step.num} —</span>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-desc">{step.description}</p>
            </div>

          </li>
        ))}
      </ol>

      <div class="scrolly-dots" aria-label={t.how.steps_label}>
        <div class="scrolly-progress-track" aria-hidden="true">
          <div class="scrolly-progress-fill" id="scrolly-progress"></div>
        </div>
        {t.how.steps.map((step, i) => (
          <button class:list={['scrolly-dot', { active: i === 0 }]} data-step={i} aria-label={`${step.num} — ${step.title}`} aria-pressed={i === 0 ? 'true' : 'false'} />
        ))}
      </div>

    </div>
  </section>
</div>

<style>
  .how-wrapper { background: var(--color-cream); height: calc(100vh * 5); }
  .how-section {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
    gap: 1.25rem;
  }
  .how-eyebrow-wrap { width: 100%; max-width: 1200px; display: flex; flex-direction: column; gap: 0.5rem; }
  .how-eyebrow { color: var(--color-slate); }
  .how-title { color: var(--color-navy-deep); }

  .scrolly-card {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    background: var(--color-navy-deep);
    color: var(--color-white);
    min-height: 60vh;
    display: grid;
    grid-template-columns: 1fr auto;
    position: relative;
    overflow: hidden;
  }

  .scrolly-dots {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1.25rem;
    align-items: center;
    position: relative;
  }
  .scrolly-progress-track {
    position: absolute;
    left: 50%; top: 2rem; bottom: 2rem;
    width: 1px;
    background: rgba(255,255,255,0.08);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .scrolly-progress-fill { width: 100%; height: 0%; background: rgba(255,255,255,0.5); transition: height 0.4s var(--ease-out-expo); }
  .scrolly-dot {
    width: 24px; height: 24px;
    display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 1;
    color: var(--color-white);
  }
  .scrolly-dot::before {
    content: '';
    width: 4px; height: 4px;
    border-radius: 50%;
    background: rgba(255,255,255,0.25);
    transition: all 0.4s var(--ease-out-expo);
  }
  .scrolly-dot.active::before { width: 2px; height: 20px; border-radius: 1px; background: rgba(255,255,255,0.9); }

  .scrolly-panels { flex: 1; position: relative; min-height: 60vh; }
  .scrolly-panel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 3rem;
    padding: 3rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
    visibility: hidden;
  }
  .scrolly-panel.active { opacity: 1; transform: translateY(0); pointer-events: auto; visibility: visible; }

  .panel-left { display: flex; flex-direction: column; justify-content: center; }

  .terminal-card { border: 1px solid rgba(255,255,255,0.15); padding: 1.25rem; background: rgba(255,255,255,0.03); }
  .terminal-bar { display: flex; gap: 6px; margin-bottom: 0.75rem; }
  .t-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.2); display: block; }
  .terminal-code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.85);
    white-space: pre-wrap;
    min-height: 9em;
  }
  .t-cursor { display: inline-block; width: 7px; height: 0.85em; background: var(--color-silver); vertical-align: middle; animation: blink 1s step-end infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .design-visual { padding: 1rem; }
  .design-frame { border: 1px solid rgba(255,255,255,0.18); overflow: hidden; }
  .design-bar { height: 28px; background: rgba(255,255,255,0.04); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .design-content { padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .design-block { background: rgba(255,255,255,0.08); height: 40px; }
  .design-block.tall { height: 60px; }
  .design-block.short { height: 20px; width: 60%; }
  .design-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }

  .facts-visual { border: 1px solid rgba(255,255,255,0.15); padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
  .facts-title { font-size: 0.625rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-silver); }
  .facts-list { display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.875rem; font-weight: 300; }
  .facts-list li { display: flex; align-items: center; gap: 0.75rem; }
  .facts-check { color: var(--color-silver); font-size: 0.8rem; }
  .facts-list--plans li { justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.5rem; }
  .facts-price { font-family: var(--font-display); font-size: 1.25rem; }
  .facts-price small { font-family: var(--font-body); font-size: 0.625rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-silver); margin-left: 0.25rem; }

  .panel-right { display: flex; flex-direction: column; justify-content: center; }
  .step-num { color: var(--color-silver); margin-bottom: 0.75rem; }
  .step-title { font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2.25rem); font-weight: 400; color: var(--color-white); line-height: 1.2; margin-bottom: 1rem; }
  .step-desc { font-size: 0.9375rem; color: var(--color-silver); line-height: 1.7; max-width: 38ch; font-weight: 300; }

  @media (max-width: 900px) {
    .how-wrapper { height: calc(100vh * 6); }
    .scrolly-card { min-height: 58vh; }
    .scrolly-panel { grid-template-columns: 1fr; padding: 1.75rem; }
    .panel-left { display: none; }
    .step-title { font-size: clamp(1.25rem, 5vw, 1.75rem); }
  }
  @media (max-width: 400px) {
    .scrolly-panel { padding: 1.25rem; }
    .how-section { padding: 0 1rem; }
  }

  /* Movimiento reducido: los pasos se apilan sin fijar la tarjeta */
  @media (prefers-reduced-motion: reduce) {
    .how-wrapper { height: auto; padding: var(--section-pad) 0; }
    .how-section { position: static; height: auto; }
    .scrolly-card { grid-template-columns: 1fr; }
    .scrolly-dots { display: none; }
    .scrolly-panels { min-height: 0; }
    .scrolly-panel { position: static; opacity: 1; transform: none; visibility: visible; pointer-events: auto; border-top: 1px solid rgba(255,255,255,0.1); }
    .t-cursor { animation: none; }
  }
</style>

<script>
  let globalBound = false;
  let currentStep = 0;
  let typewriterTimer: ReturnType<typeof setInterval> | undefined;

  function els() {
    return {
      wrapper: document.getElementById('how-wrapper'),
      panels: Array.from(document.querySelectorAll<HTMLElement>('.scrolly-panel')),
      dots: Array.from(document.querySelectorAll<HTMLButtonElement>('.scrolly-dot')),
      progress: document.getElementById('scrolly-progress'),
    };
  }

  function startTypewriter(): void {
    const output = document.getElementById('typewriter-output');
    const pre = output?.closest<HTMLElement>('.terminal-code');
    if (!output || !pre || output.dataset.done === '1') return;
    output.dataset.done = '1';
    const text = pre.dataset.brief ?? '';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      output.textContent = text;
      return;
    }
    let i = 0;
    clearInterval(typewriterTimer);
    typewriterTimer = setInterval(() => {
      output.textContent = text.slice(0, ++i);
      if (i >= text.length) clearInterval(typewriterTimer);
    }, 38);
  }

  function activateStep(idx: number): void {
    const { panels, dots } = els();
    const next = panels[idx];
    if (!next) return;
    if (idx === currentStep && next.classList.contains('active')) return;
    panels.forEach((p, i) => p.classList.toggle('active', i === idx));
    dots.forEach((d, i) => {
      d.classList.toggle('active', i === idx);
      d.setAttribute('aria-pressed', String(i === idx));
    });
    currentStep = idx;
    if (idx === 0) startTypewriter();
  }

  function onScroll(): void {
    const { wrapper, panels, progress } = els();
    if (!wrapper || panels.length === 0) return;
    const rect = wrapper.getBoundingClientRect();
    const total = wrapper.offsetHeight - window.innerHeight;
    if (total <= 0) return;
    const scrolled = -rect.top;
    if (scrolled < 0 || scrolled > total) return;
    const ratio = scrolled / total;
    activateStep(Math.min(Math.floor(ratio * panels.length), panels.length - 1));
    if (progress) progress.style.height = `${ratio * 100}%`;
  }

  function init(): void {
    const { wrapper, dots, panels } = els();
    if (!wrapper) return;
    currentStep = 0;
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const total = wrapper.offsetHeight - window.innerHeight;
        const target = wrapper.offsetTop + (i / panels.length) * total + 1;
        window.scrollTo({ top: target, behavior: 'smooth' });
        activateStep(i);
      });
    });
    if (!globalBound) {
      globalBound = true;
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    startTypewriter();
    onScroll();
  }

  document.addEventListener('astro:page-load', init);
</script>
