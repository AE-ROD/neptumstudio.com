---
// src/components/Hero.astro
import type { Locale } from '../i18n';
import { getT, routes, quoteHref } from '../i18n';
import { diagnostic } from '../data/catalog';
import LogoMark from './LogoMark.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getT(locale);
---

<section id="hero" class="hero">
  <div class="hero-content" data-hero-reveal>
    <p class="eyebrow eyebrow--light">{t.hero.eyebrow}</p>
    <h1 class="display-xl hero-h1">
      {t.hero.h1} <em>{t.hero.h1_em}</em>
    </h1>
    <p class="hero-sub">{t.hero.subtitle}</p>
    <div class="hero-btns">
      <a href={routes[locale].services} class="btn btn-light">{t.hero.cta_services}</a>
      <a href={quoteHref(locale, diagnostic.id)} class="btn btn-outline-light">{t.hero.cta_diagnostic}</a>
    </div>
  </div>

  <div class="hero-visual" data-hero-reveal aria-hidden="true">
    <div class="hero-visual-inner">
      <div class="hero-glow"></div>
      <LogoMark class="hero-mark" />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    background: var(--color-navy-deep);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "content visual";
    align-items: center;
    padding: var(--nav-height) 0 0;
    position: relative;
    overflow: hidden;
  }
  .hero-content {
    grid-area: content;
    padding: var(--section-pad) 0 var(--section-pad) max(1.5rem, (100vw - 1200px) / 2);
    max-width: 680px;
  }
  .hero-content .eyebrow { margin-bottom: 1.25rem; }
  .hero-h1 { color: var(--color-white); margin-bottom: 1.25rem; }
  .hero-h1 em { color: var(--color-silver); }
  .hero-sub {
    font-size: 1rem;
    color: var(--color-silver);
    line-height: 1.7;
    max-width: 46ch;
    margin-bottom: 2rem;
    font-weight: 300;
  }
  .hero-btns { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }

  .hero-visual {
    grid-area: visual;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding-right: max(1.5rem, (100vw - 1200px) / 2);
  }
  .hero-visual-inner {
    width: min(360px, 42vw);
    height: min(360px, 42vw);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(27,43,69,0.9) 0%, transparent 70%);
    animation: pulse-glow 4s ease-in-out infinite;
  }
  @keyframes pulse-glow {
    0%,100% { transform: scale(1); opacity: 0.8; }
    50%      { transform: scale(1.08); opacity: 1; }
  }
  .hero-mark { width: 52%; height: 52%; color: var(--color-silver); opacity: 0.5; position: relative; z-index: 1; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; grid-template-areas: "content"; align-items: start; }
    .hero-visual { display: none; }
    .hero-content { max-width: 640px; padding: calc(var(--nav-height) + 2.5rem) 1.5rem 2.5rem; }
  }
  @media (max-width: 400px) {
    .hero-btns { flex-direction: column; align-items: stretch; }
    .hero-btns .btn { width: 100%; }
  }
</style>

<script>
  // Parallax suave del isotipo (se omite con movimiento reducido)
  let bound = false;
  function onScroll(): void {
    const visual = document.querySelector<HTMLElement>('.hero-visual-inner');
    if (visual) visual.style.transform = `translateY(-${window.scrollY * 0.25}px)`;
  }
  document.addEventListener('astro:page-load', () => {
    if (bound || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    bound = true;
    window.addEventListener('scroll', onScroll, { passive: true });
  });
</script>
