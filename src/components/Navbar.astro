---
// src/components/Navbar.astro
import type { Locale, PageKey } from '../i18n';
import { getT, locales, routes, href, quoteHref } from '../i18n';
import { diagnostic } from '../data/catalog';
import LogoMark from './LogoMark.astro';

interface Props {
  locale: Locale;
  page: PageKey;
}
const { locale, page } = Astro.props;
const t = getT(locale);

const links = [
  { key: 'services', label: t.nav.services, url: routes[locale].services, current: page === 'services' },
  { key: 'how', label: t.nav.how, url: href(locale, 'home', { hash: 'how' }), current: false },
  { key: 'contact', label: t.nav.contact, url: routes[locale].contact, current: page === 'contact' },
];
const diagnosticUrl = quoteHref(locale, diagnostic.id);
---

<header id="navbar" data-hero-reveal>
  <div class="nav-inner container">

    <a href={routes[locale].home} class="nav-logo" aria-label={t.nav.home_label}>
      <LogoMark class="logo-mark" />
      <span class="logo-text">Neptum Studio</span>
    </a>

    <nav class="nav-links" aria-label={t.nav.main_label}>
      {links.map((l) => (
        <a href={l.url} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-right">
      <nav class="lang-switch" aria-label={t.nav.lang_label}>
        {locales.map((lang) => (
          <a
            href={routes[lang][page]}
            class:list={['lang-btn', { active: lang === locale }]}
            lang={lang}
            hreflang={lang}
            aria-current={lang === locale ? 'true' : undefined}
          >
            {lang.toUpperCase()}
          </a>
        ))}
      </nav>

      <a href={diagnosticUrl} class="btn btn-light nav-cta">{t.nav.diagnostic}</a>

      <button class="hamburger" id="hamburger" aria-label={t.nav.menu_open} aria-expanded="false" aria-controls="mobile-menu" data-label-open={t.nav.menu_open} data-label-close={t.nav.menu_close}>
        <span></span><span></span>
      </button>
    </div>

  </div>
</header>

<!-- El menú móvil vive fuera de <header> para que position:fixed no dependa de transformaciones del navbar -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-logo">
    <LogoMark class="mobile-logo-mark" />
    <span class="mobile-logo-text">Neptum Studio</span>
  </div>

  <nav class="mobile-links" aria-label={t.nav.main_label}>
    {links.map((l) => (
      <a href={l.url} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href={diagnosticUrl} class="btn btn-light mobile-cta">{t.nav.diagnostic}</a>
  </nav>

  <nav class="mobile-lang" aria-label={t.nav.lang_label}>
    {locales.map((lang) => (
      <a href={routes[lang][page]} class:list={['lang-btn', { active: lang === locale }]} lang={lang} hreflang={lang} aria-current={lang === locale ? 'true' : undefined}>
        {lang.toUpperCase()}
      </a>
    ))}
  </nav>
</div>

<style>
  #navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    height: var(--nav-height);
    transition: background 0.4s ease, height 0.4s ease, box-shadow 0.4s ease;
  }
  #navbar.scrolled {
    background: rgba(13, 27, 42, 0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-navy-mid);
    height: 60px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.25);
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav-logo { display: flex; align-items: center; gap: 0.6rem; color: var(--color-white); }
  .logo-mark { height: 30px; width: auto; }
  .logo-text {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links { display: flex; gap: 2rem; align-items: center; }
  .nav-links a {
    font-size: var(--label-size);
    letter-spacing: var(--label-tracking);
    color: var(--color-silver);
    text-transform: uppercase;
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .nav-links a:hover { color: var(--color-white); }
  .nav-links a[aria-current="page"] { color: var(--color-white); border-bottom-color: var(--color-silver); }

  .nav-right { display: flex; align-items: center; gap: 1rem; }

  .lang-switch { display: flex; border: 1px solid var(--color-navy-mid); }
  .lang-btn {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.6rem;
    color: var(--color-silver);
    transition: background 0.2s, color 0.2s;
  }
  .lang-btn.active, .lang-btn:hover { background: var(--color-navy-mid); color: var(--color-white); }

  .nav-cta { padding: 0.6rem 1.1rem; min-height: 38px; }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px; height: 44px;
    align-items: center;
  }
  .hamburger span {
    display: block;
    width: 22px; height: 1.5px;
    background: var(--color-white);
    transition: transform 0.3s;
  }
  .hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(3.75px) rotate(45deg); }
  .hamburger[aria-expanded="true"] span:nth-child(2) { transform: translateY(-3.75px) rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--color-navy-deep);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s;
    z-index: 200;
    padding: 2rem 1.5rem;
  }
  .mobile-menu.open { opacity: 1; visibility: visible; pointer-events: auto; }

  .mobile-menu-logo { display: flex; align-items: center; gap: 0.6rem; color: var(--color-white); }
  .mobile-logo-mark { width: 28px; height: 28px; }
  .mobile-logo-text { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: 0.08em; }

  .mobile-links { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .mobile-links a:not(.btn) {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-white);
    transition: color 0.2s;
  }
  .mobile-links a:not(.btn):hover { color: var(--color-silver); }
  .mobile-cta { margin-top: 0.5rem; }

  .mobile-lang { display: flex; gap: 0.75rem; }
  .mobile-lang .lang-btn { font-size: 0.75rem; padding: 0.5rem 0.8rem; border: 1px solid var(--color-navy-mid); min-width: 44px; text-align: center; }

  /* Tablet (901-1200px) */
  @media (min-width: 901px) and (max-width: 1200px) {
    .nav-links { gap: 1.25rem; }
    .nav-inner { gap: 1rem; }
    .nav-links a { font-size: 0.625rem; }
  }
  /* Móvil y tablet vertical (≤900px) */
  @media (max-width: 900px) {
    .nav-links, .nav-cta, .lang-switch { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  let globalBound = false;

  function onScroll(): void {
    const navbar = document.getElementById('navbar');
    if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 20);
  }

  function setMenu(open: boolean, unlockScroll = true): void {
    const hamburger = document.getElementById('hamburger');
    const menu = document.getElementById('mobile-menu');
    if (!hamburger || !menu) return;
    menu.classList.toggle('open', open);
    hamburger.setAttribute('aria-expanded', String(open));
    hamburger.setAttribute('aria-label', open ? (hamburger.dataset.labelClose ?? 'Close') : (hamburger.dataset.labelOpen ?? 'Menu'));
    menu.setAttribute('aria-hidden', String(!open));
    // Al navegar a otra página, el scroll se libera en astro:page-load para no alterar el viewport
    // durante la transición de vista (la barra de scroll cambiaría el tamaño y la abortaría).
    if (open) document.body.style.overflow = 'hidden';
    else if (unlockScroll) document.body.style.overflow = '';
  }

  function init(): void {
    const hamburger = document.getElementById('hamburger');
    const menu = document.getElementById('mobile-menu');
    if (!hamburger || !menu) return;

    document.body.style.overflow = '';
    hamburger.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        const samePage = link.pathname === location.pathname && link.search === location.search;
        setMenu(false, samePage);
      }),
    );

    if (!globalBound) {
      globalBound = true;
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
    }
    onScroll();
  }

  document.addEventListener('astro:page-load', init);
</script>
