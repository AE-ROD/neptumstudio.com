---
// src/components/Footer.astro
import type { Locale, PageKey } from '../i18n';
import { getT, locales, routes, href } from '../i18n';
import { lines, lineInfo } from '../data/catalog';
import { CONTACT } from '../data/contact';
import LogoMark from './LogoMark.astro';

interface Props {
  locale: Locale;
  page: PageKey;
}
const { locale, page } = Astro.props;
const t = getT(locale);
const year = new Date().getFullYear();
---

<footer id="footer" class="footer">
  <div class="container">

    <div class="footer-top">
      <div class="footer-brand">
        <a href={routes[locale].home} class="footer-logo" aria-label={t.nav.home_label}>
          <LogoMark class="footer-mark" />
          <span>Neptum Studio</span>
        </a>
        <p class="footer-tagline">{t.footer.tagline}</p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h2>{t.footer.cols.services}</h2>
          {lines.map((line) => (
            <a href={href(locale, 'services', { hash: line })}>{lineInfo[line].label[locale]}</a>
          ))}
          <a href={href(locale, 'services', { hash: 'packs' })}>{t.footer.links.packs}</a>
          <a href={href(locale, 'services', { hash: 'planes' })}>{t.footer.links.plans}</a>
        </div>
        <div class="footer-col">
          <h2>{t.footer.cols.studio}</h2>
          <a href={href(locale, 'home', { hash: 'how' })}>{t.nav.how}</a>
          <a href={href(locale, 'services', { hash: 'diagnostico' })}>{t.nav.diagnostic}</a>
          <a href={routes[locale].contact}>{t.nav.contact}</a>
        </div>
        <div class="footer-col">
          <h2>{t.footer.cols.contact}</h2>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={CONTACT.whatsappUrl} target="_blank" rel="noopener">{CONTACT.phoneDisplay}</a>
          <a href={CONTACT.instagramUrl} target="_blank" rel="noopener">{CONTACT.instagramHandle}</a>
          <span>{CONTACT.city}, {CONTACT.country}</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Neptum Studio · {t.footer.copyright}</span>
      <nav class="footer-lang" aria-label={t.nav.lang_label}>
        {locales.map((lang) => (
          <a href={routes[lang][page]} class:list={['flang', { active: lang === locale }]} lang={lang} hreflang={lang} aria-current={lang === locale ? 'true' : undefined}>
            {lang.toUpperCase()}
          </a>
        ))}
      </nav>
    </div>

  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    padding: clamp(3rem, 5vw, 5rem) 0 2rem;
    color: var(--color-silver);
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-navy-mid);
    margin-bottom: 1.5rem;
  }
  .footer-brand { max-width: 260px; }
  .footer-logo { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.75rem; color: var(--color-white); }
  .footer-mark { width: 28px; height: auto; }
  .footer-logo span { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: 0.08em; }
  .footer-tagline {
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-silver);
  }

  .footer-cols { display: flex; gap: 3rem; flex-wrap: wrap; }
  .footer-col { min-width: 140px; }
  .footer-col h2 {
    font-family: var(--font-body);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-silver);
    margin-bottom: 0.875rem;
    font-weight: 600;
  }
  .footer-col a, .footer-col span {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-silver);
    margin-bottom: 0.5rem;
    transition: color 0.2s;
    font-weight: 300;
  }
  .footer-col a:hover { color: var(--color-white); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-bottom > span { font-size: 0.75rem; color: var(--color-silver); }

  .footer-lang { display: flex; gap: 0.25rem; }
  .flang {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--color-silver);
    padding: 0.5rem 0.6rem;
    border: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .flang.active, .flang:hover { color: var(--color-white); border-color: var(--color-navy-mid); }

  @media (max-width: 900px) {
    .footer-top { flex-direction: column; }
    .footer-cols { gap: 2rem; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 768px) {
    .footer { padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px)); }
  }
</style>
