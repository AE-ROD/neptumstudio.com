---
// src/components/Loader.astro
// Franja de saludos multilingües. Se muestra en la primera carga de la sesión (y al recargar);
// en navegaciones internas con transiciones de vista se oculta de inmediato.
---

<div class="loading-container" id="loader" aria-hidden="true">
  <div class="loading-screen" id="loader-screen">

    <div class="rounded-div-wrap top">
      <div class="rounded-div"></div>
    </div>

    <div class="loading-words" id="loader-words">
      <span>Hello</span>
      <span>Bonjour</span>
      <span>Ciao</span>
      <span>Olá</span>
      <span>Hola</span>
      <span>こんにちは</span>
      <span>Hallå</span>
      <span>Guten Tag</span>
      <span>Hallo</span>
    </div>

    <div class="rounded-div-wrap bottom" id="loader-bottom">
      <div class="rounded-div"></div>
    </div>

  </div>
</div>

<style>
  .loading-container {
    position: fixed;
    inset: 0;
    z-index: 800;
    overflow: hidden;
    pointer-events: none;
  }
  .loading-screen {
    background-color: var(--color-loader);
    width: 100%;
    height: 100%;
    min-height: -webkit-fill-available;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rounded-div-wrap {
    position: absolute;
    left: 0;
    width: 100%;
    overflow: hidden;
    height: 12vh;
  }
  .rounded-div-wrap.top { top: -1px; transform: scaleY(-1); }
  .rounded-div-wrap.bottom { bottom: -1px; }
  .rounded-div {
    width: 150%;
    height: 750%;
    background-color: var(--color-loader);
    border-radius: 50%;
    position: absolute;
    left: 50%;
    transform: translate(-50%, -86.666%);
  }
  .loading-words {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    opacity: 0;
  }
  .loading-words span {
    font-family: var(--font-body);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 300;
    color: var(--color-white);
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  /* Sin JavaScript o con movimiento reducido, la franja no bloquea nada */
  @media (prefers-reduced-motion: reduce) {
    .loading-container { display: none; }
  }
</style>
<noscript><style>.loading-container { display: none; }</style></noscript>

<script>
  import { gsap } from 'gsap';

  const SEEN_KEY = 'introSeen';
  let playedThisVisit = false;

  function hasSeenIntro(): boolean {
    try { return sessionStorage.getItem(SEEN_KEY) === '1'; } catch { return false; }
  }
  function markSeen(): void {
    try { sessionStorage.setItem(SEEN_KEY, '1'); } catch { /* almacenamiento no disponible */ }
  }

  function hideLoader(): void {
    const container = document.getElementById('loader');
    if (container) container.style.display = 'none';
    document.body.style.overflow = '';
    document.body.style.cursor = '';
  }

  function run(): void {
    const container = document.getElementById('loader');
    if (!container) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const navType = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
    const isHardLoad = !playedThisVisit && !reduceMotion && (!hasSeenIntro() || navType === 'reload');

    if (!isHardLoad) {
      hideLoader();
      gsap.set('[data-hero-reveal]', { clearProps: 'transform,opacity' });
      return;
    }

    playedThisVisit = true;
    const screen = document.getElementById('loader-screen')!;
    const wordsEl = document.getElementById('loader-words')!;
    const words = Array.from(wordsEl.querySelectorAll('span')) as HTMLElement[];
    const reveal = gsap.utils.toArray<HTMLElement>('[data-hero-reveal]');

    document.body.style.overflow = 'hidden';
    document.body.style.cursor = 'wait';

    // Seguridad: si la animación se interrumpe, nunca dejamos la pantalla tapada.
    const safetyTimer = setTimeout(() => {
      hideLoader();
      gsap.set(reveal, { clearProps: 'transform,opacity' });
    }, 5000);

    const tl = gsap.timeline({
      onComplete() {
        clearTimeout(safetyTimer);
        markSeen();
        hideLoader();
      },
    });

    // El contenido entra elevándose un poco y apareciendo, sin cruzar otras secciones
    gsap.set(reveal, { y: 40, opacity: 0 });
    gsap.set(screen, { top: 0 });
    gsap.set(wordsEl, { opacity: 0, y: -50 });
    gsap.set(words, { opacity: 0 });
    if (words[0]) gsap.set(words[0], { opacity: 1 });

    tl.to(wordsEl, { duration: 0.8, opacity: 1, y: 0, ease: 'power4.out', delay: 0.5 });

    const wordsTl = gsap.timeline();
    words.forEach((word, i) => {
      const prev = words[i > 0 ? i - 1 : 0];
      wordsTl
        .to(word, { duration: 0.01, opacity: 1 })
        .to(prev as gsap.TweenTarget, { duration: 0.01, opacity: i === 0 ? 1 : 0 }, '<')
        .to(word as gsap.TweenTarget, { duration: 0.13 });
    });
    wordsTl.to(wordsEl as gsap.TweenTarget, { duration: 0.35 });
    tl.add(wordsTl);

    tl.to(screen, {
      duration: 0.8,
      top: '-100%',
      ease: 'power4.out',
      onStart() {
        gsap.to(reveal, {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: 'power4.out',
          stagger: 0.08,
          onComplete() { gsap.set(reveal, { clearProps: 'transform,opacity' }); },
        });
      },
    });
  }

  // En navegaciones internas, ocultar antes de pintar la nueva página.
  document.addEventListener('astro:after-swap', hideLoader);
  document.addEventListener('astro:page-load', run);
</script>
