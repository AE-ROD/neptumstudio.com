---
// src/components/Loader.astro
---

<div class="loading-container" id="loader">
  <div class="loading-screen" id="loader-screen">

    <div class="rounded-div-wrap top">
      <div class="rounded-div"></div>
    </div>

    <div class="loading-words" id="loader-words" aria-hidden="true">
      <span>Hello</span>
      <span>Bonjour</span>
      <span>Ciao</span>
      <span>Olá</span>
      <span>Hola</span>
      <span>こんにちは</span>
      <span>Hallå</span>
      <span>Guten tag</span>
      <span>Hallo</span>
    </div>

    <div class="rounded-div-wrap bottom" id="loader-bottom">
      <div class="rounded-div"></div>
    </div>

  </div>
</div>

<style>
  .loading-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* inset:0 + no explicit height — covers the full visual viewport on iOS Safari */
    z-index: 800;
    overflow: hidden;
    pointer-events: none;
  }

  .loading-screen {
    background-color: #141517;
    width: 100%;
    height: 100%;
    /* Stretch to fill on iOS Safari */
    min-height: -webkit-fill-available;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rounded-div-wrap {
    position: absolute;
    left: 0;
    width: 100%;
    overflow: hidden;
    height: 12vh;
  }
  .rounded-div-wrap.top {
    top: -1px; /* cover the exact top edge */
    transform: scaleY(-1);
  }
  .rounded-div-wrap.bottom {
    bottom: -1px; /* cover the exact bottom edge */
  }
  .rounded-div {
    width: 150%;
    height: 750%;
    background-color: #141517;
    border-radius: 50%;
    position: absolute;
    left: 50%;
    transform: translate(-50%, -86.666%);
  }

  .loading-words {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    opacity: 0;
  }
  .loading-words span {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 300;
    color: #ffffff;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
</style>

<script>
  import { gsap } from 'gsap';

  const container = document.getElementById('loader')!;
  const screen    = document.getElementById('loader-screen')!;
  const wordsEl   = document.getElementById('loader-words')!;
  const words     = Array.from(wordsEl.querySelectorAll('span')) as HTMLElement[];

  function clearLoader() {
    container.style.display = 'none';
    document.body.style.overflow = '';
    document.body.style.cursor   = 'auto';
  }

  // Show loader on first visit AND on hard reload (Cmd+Shift+R / F5).
  // Skip only on in-session navigations (data-astro-reload links between pages).
  const navType = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
  const isHardLoad = !sessionStorage.getItem('introSeen') || navType === 'reload';

  if (!isHardLoad) {
    clearLoader();
    gsap.set('[data-hero-reveal]', { y: 0 });
  } else {

  document.body.style.overflow = 'hidden';
  document.body.style.cursor   = 'wait';

  // Safety: always clear if GSAP is interrupted (hot reload, slow tab, etc.)
  const safetyTimer = setTimeout(clearLoader, 5000);

  const tl = gsap.timeline({
    onComplete() {
      clearTimeout(safetyTimer);
      sessionStorage.setItem('introSeen', '1');
      clearLoader();
    }
  });

  gsap.set(screen,  { top: 0 });
  gsap.set(wordsEl, { opacity: 0, y: -50 });
  gsap.set(words,   { opacity: 0 });
  if (words[0]) gsap.set(words[0], { opacity: 1 });

  tl.to(wordsEl, {
    duration: 0.8,
    opacity: 1,
    y: 0,
    ease: 'power4.out',
    delay: 0.5
  });

  const wordsTl = gsap.timeline();
  words.forEach((word, i) => {
    const prev = words[i > 0 ? i - 1 : 0];
    wordsTl
      .to(word, { duration: 0.01, opacity: 1 })
      .to(prev as gsap.TweenTarget, { duration: 0.01, opacity: i === 0 ? 1 : 0 }, '<')
      .to(word as gsap.TweenTarget, { duration: 0.13 });
  });
  wordsTl.to(wordsEl as gsap.TweenTarget, { duration: 0.35 });
  tl.add(wordsTl);

  tl.to(screen, {
    duration: 0.8,
    top: '-100%',
    ease: 'power4.out',
    onStart() {
      gsap.to('[data-hero-reveal]', {
        y: 0,
        duration: 0.8,
        ease: 'power4.out',
        stagger: 0.08
      });
    }
  });

  } // end else (sessionStorage check)
</script>
