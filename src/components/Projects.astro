---
// src/components/Projects.astro — se renderiza solo si hay proyectos en src/data/projects.ts
import type { Locale } from '../i18n';
import { getT } from '../i18n';
import { projects } from '../data/projects';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getT(locale);
const hasProjects = projects.length > 0;
---

{hasProjects && (
  <section id="projects" class="section section--navy">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--light">{t.projects.eyebrow}</p>
        <h2 class="display-lg">{t.projects.h2}</h2>
      </div>
      <ul class="projects-grid" role="list">
        {projects.map((p) => (
          <li class="proj-card">
            {p.image && <img src={p.image} alt="" loading="lazy" decoding="async" class="proj-img" />}
            <p class="sku proj-cat">{p.category[locale]}{p.year ? ` · ${p.year}` : ''}</p>
            <h3 class="proj-name">{p.name}</h3>
            <p class="proj-desc">{p.description[locale]}</p>
            {p.url && (
              <a href={p.url} target="_blank" rel="noopener" class="link-label link-label--light">{t.projects.view} →</a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .projects-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .proj-card {
    border: 1px solid var(--color-navy-mid);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .proj-img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; }
  .proj-cat { color: var(--color-silver); }
  .proj-name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; }
  .proj-desc { font-size: 0.875rem; color: var(--color-silver); line-height: 1.65; font-weight: 300; flex: 1; }
  @media (max-width: 900px) { .projects-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .projects-grid { grid-template-columns: 1fr; } }
</style>
